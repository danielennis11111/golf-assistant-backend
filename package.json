      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielennis11111/golf-assistant-backend.git"
  },
  "bugs": {
    "url": "https://github.com/danielennis11111/golf-assistant-backend/issues"
  },
  "homepage": "https://ai-golf-assistant.surge.sh"
